# 墨白云 API Key 配置模板
# 复制本文件为 .env，填入你的密钥（.env 已被 .gitignore 排除，不会提交）

# ================ DeepSeek ================
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# ================ Azure 语音 TTS（可选） ================
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=

# ================ Flask 密钥（生产环境务必设置强随机值） ================
FLASK_SECRET_KEY=
